# Cloudflare Workers AI — powers the on-demand Rules of Evidence question
# generator at /api/evidence-question. Copy this file to .env.local and fill in
# your values. Without these set, the trainer automatically uses its built-in
# curated question bank, so the site still works.
#
# Where to get them:
#   1. Account ID:  Cloudflare dashboard → Workers & Pages (right sidebar), or
#                   any zone's Overview page.
#   2. API token:   dashboard → My Profile → API Tokens → Create Token.
#                   Give it the "Workers AI" permission (Account → Workers AI → Read/Run).
#
# Workers AI has a free daily allocation (Neurons) that is plenty for a club
# site. In production, set these as project secrets in your Cloudflare deployment
# rather than committing them.

CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_workers_ai_token_here
